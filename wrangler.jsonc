{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafaaudibert-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    // Astro defaults here (trailingSlash "ignore", build.format "directory"),
    // so auto-trailing-slash matches: /blog and /blog/ both resolve.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Bound so the Worker can hand non-API requests straight back to the
    // asset server rather than reimplementing static serving.
    "binding": "ASSETS",
    // Paths the Worker sees before the asset server does. /mcp needs it
    // because a docs page (GET from a browser) and the MCP endpoint (POST)
    // share the path, and assets would win for anything with a file behind
    // it. Once this is a list, every other path is asset-only and a miss
    // gets the 404 page instead of reaching the Worker, so /api/* has to be
    // listed too or the sorting playground stops working. Add any new Worker
    // route here.
    "run_worker_first": ["/mcp", "/mcp/", "/api/*"]
  },
  // The email composer's mail (worker/contact.ts). Sending is free only to a
  // verified Email Routing destination address, which the CONTACT_TO secret
  // holds: me@rafaaudibert.dev is a routing address, not a destination, and
  // the binding refuses it ("destination address is not a verified
  // address"). `wrangler dev` only simulates sends and logs them.
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  // Per Cloudflare location, eventually consistent, period 10 or 60 seconds
  // only. Turnstile does the real gatekeeping; these keep one visitor, or a
  // burst of them, from filling the inbox. namespace_id must be unique in
  // the account.
  "ratelimits": [
    { "name": "CONTACT_VISITOR_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "CONTACT_GLOBAL_LIMIT", "namespace_id": "1002", "simple": { "limit": 6, "period": 60 } }
  ],
  "routes": [
    { "pattern": "rafaaudibert.dev", "custom_domain": true },
    { "pattern": "www.rafaaudibert.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
