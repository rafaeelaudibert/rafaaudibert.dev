---
/**
 * A floating email composer, opened by any element with `data-email-composer`
 * (the envelope in the nav, "Email" in the footer). It's a non-modal dialog
 * pinned to the corner, or a sheet along the bottom on phones, so the page
 * stays usable behind it. It persists across client-side navigation, so a
 * draft survives moving around the site.
 *
 * Sending goes to the Worker's /api/contact (worker/contact.ts). Turnstile
 * checks for a person in the background while the visitor writes: the widget
 * is "interaction-only", so it stays invisible unless Cloudflare wants a
 * click, and then appears above the Send button.
 */
import Icon from "./Icon.astro"
import {
  MAX_EMAIL_LENGTH,
  MAX_MESSAGE_LENGTH,
  MAX_SUBJECT_LENGTH,
} from "../utils/contact"
---

{/* Persisted so a half-written email survives moving around the site */}
<email-composer transition:persist="email-composer">
  <dialog id="email-composer" class="composer" aria-labelledby="composer-title">
    <form novalidate>
      <header class="head" data-head>
        {/* Phones only: the sheet's handle, for pulling it down */}
        <span class="grabber" aria-hidden="true"></span>
        <h2 id="composer-title" class="title">Email Rafa</h2>
        <button type="button" class="close" data-close aria-label="Close">
          <Icon icon="x" size="1rem" />
        </button>
      </header>

      {/* The fields fold away once the email is sent, and the note below unfolds in their place */}
      <div class="fold fields-fold" data-fields>
      <div class="fold-inner">
      <label class="row">
        <span class="row-label">From</span>
        <input
          name="from"
          type="email"
          inputmode="email"
          autocomplete="email"
          enterkeyhint="next"
          spellcheck="false"
          maxlength={MAX_EMAIL_LENGTH}
          placeholder="you@example.com"
          aria-describedby="composer-from-help"
          required
        />
      </label>
      <p id="composer-from-help" class="sr-only">So I can write back.</p>

      <label class="row">
        <span class="row-label">Subject</span>
        <input
          name="subject"
          type="text"
          enterkeyhint="next"
          maxlength={MAX_SUBJECT_LENGTH}
          placeholder="Optional"
        />
      </label>

      <label class="sr-only" for="composer-message">Message</label>
      <textarea
        id="composer-message"
        name="message"
        rows="7"
        maxlength={MAX_MESSAGE_LENGTH}
        placeholder="What's on your mind?"
        required></textarea>

      {/* Nobody sees this one. Whatever fills it in isn't a person. */}
      <div class="trap" aria-hidden="true">
        <label>Fax <input name="fax" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>

      {/* Turnstile renders here, and only shows itself if it needs a click */}
      <div class="challenge" data-challenge></div>
      </div>
      </div>

      <div class="fold sent-fold" data-sent inert>
        <div class="fold-inner">
          <div class="sent">
            <svg class="sent-mark" viewBox="0 0 48 48" aria-hidden="true">
              <circle cx="24" cy="24" r="21" pathLength="1" />
              <path d="M15 24.5l6.5 6.5L33.5 18" pathLength="1" />
            </svg>
            <div>
              <p class="sent-title">Sent</p>
              <p class="sent-text">Thanks! I'll reply to <span data-sent-to></span>.</p>
            </div>
          </div>
        </div>
      </div>

      <footer class="foot">
        <p class="message" data-message role="alert"></p>
        <p class="hint" data-hint aria-hidden="true">
          <kbd data-mod>Ctrl</kbd><kbd>↵</kbd> to send
        </p>
        <button type="submit" class="send" data-send>
          {/* One slot, three states: the plane flies off, a spinner turns, a check lands */}
          <span class="send-icon" aria-hidden="true">
            <span class="send-plane"><Icon icon="paper-plane-tilt" size="1rem" /></span>
            <span class="send-spinner"></span>
            <svg class="send-check" viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" pathLength="1" /></svg>
          </span>
          <span data-send-label>Send</span>
        </button>
      </footer>

      <p class="sr-only" aria-live="polite" data-live></p>
    </form>
  </dialog>
</email-composer>

<script>
  import { TURNSTILE_SITE_KEY } from "astro:env/client"
  import {
    CONTACT_MAILTO,
    CONTACT_PATH,
    TURNSTILE_ACTION,
    TURNSTILE_TEST_SITE_KEY,
    hasText,
    isEmailAddress,
  } from "../utils/contact"

  interface TurnstileApi {
    render(container: HTMLElement, options: Record<string, unknown>): string
    reset(widgetId: string): void
  }

  declare global {
    interface Window {
      turnstile?: TurnstileApi
    }
  }

  /** How long "Sent" stays up before the composer puts itself away. */
  const SENT_LINGER_MS = 2600
  /**
   * "Sending" stays up at least this long. Locally, and often in production,
   * the answer comes back in a few milliseconds, and a state that flashes by
   * reads as a glitch rather than as progress.
   */
  const MIN_SENDING_MS = 900
  /** The composer's exit, so it only empties once it's out of sight. */
  const EXIT_MS = 200

  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))
  /** How long to wait for Turnstile, including a visitor clicking its checkbox. */
  const CHALLENGE_TIMEOUT_MS = 60_000
  const TRIGGER = "[data-email-composer]"
  /**
   * Where the composer is a modal sheet from the bottom edge instead of a
   * floating window. Matches the stylesheet.
   */
  const SHEET = "(max-width: 40em), (pointer: coarse) and (max-height: 32.5em)"
  /** How far the sheet has to be pulled down, or how fast in px/ms, before it lets go. */
  const DISMISS_DISTANCE = 96
  const DISMISS_VELOCITY = 0.5
  const FIELD_ORDER = ["from", "subject", "message"]

  // Local servers pair with the test secret in .dev.vars
  const isLocal = ["localhost", "127.0.0.1", "[::1]"].includes(location.hostname)
  const siteKey = isLocal ? TURNSTILE_TEST_SITE_KEY : TURNSTILE_SITE_KEY

  let turnstileScript: Promise<TurnstileApi> | undefined

  /** Loads Turnstile the first time someone opens the composer, never before. */
  function loadTurnstile() {
    turnstileScript ??= new Promise<TurnstileApi>((resolve, reject) => {
      const script = document.createElement("script")
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      script.onload = () => (window.turnstile ? resolve(window.turnstile) : reject())
      script.onerror = () => {
        turnstileScript = undefined
        script.remove()
        reject()
      }
      document.head.append(script)
    })
    return turnstileScript
  }

  class EmailComposer extends HTMLElement {
    dialog!: HTMLDialogElement
    form!: HTMLFormElement
    trigger: HTMLElement | null = null
    status: "idle" | "sending" | "sent" = "idle"
    closing: ReturnType<typeof setTimeout> | undefined

    widgetId: string | null = null
    token: string | null = null
    challengeFailed = false
    waiting: Array<(token: string | null) => void> = []
    drag: { startY: number; lastY: number; lastAt: number; velocity: number } | null = null

    connectedCallback() {
      // Persisted across navigation means connected again after each swap
      if (this.dialog) return

      this.dialog = this.querySelector("dialog")!
      this.form = this.querySelector("form")!

      const isApple = /Mac|iPhone|iPad/.test(navigator.platform)
      this.querySelector("[data-mod]")!.textContent = isApple ? "⌘" : "Ctrl"

      this.form.addEventListener("submit", (event) => {
        event.preventDefault()
        void this.send()
      })
      this.querySelector("[data-close]")!.addEventListener("click", () => this.close())
      this.dialog.addEventListener("keydown", (event) => this.handleKeyDown(event))
      // As a modal sheet, Escape (or a phone's back gesture) cancels the
      // dialog; close it the same way the button does
      this.dialog.addEventListener("cancel", (event) => {
        event.preventDefault()
        this.close()
      })
      // A tap on the dim around the sheet puts it away: closedby="any" (set in
      // open()) does that natively, through the cancel handler above. Safari
      // has no closedby yet, so there the press and the release both have to
      // land outside the sheet, which a text selection dragged off it doesn't
      if (!("closedBy" in HTMLDialogElement.prototype)) {
        const isOutside = (event: PointerEvent) => {
          const box = this.dialog.getBoundingClientRect()
          return (
            event.clientX < box.left ||
            event.clientX > box.right ||
            event.clientY < box.top ||
            event.clientY > box.bottom
          )
        }
        let pressedOutside = false
        this.dialog.addEventListener("pointerdown", (event) => {
          pressedOutside = isOutside(event)
        })
        this.dialog.addEventListener("pointerup", (event) => {
          if (pressedOutside && isOutside(event)) this.close()
        })
      }

      // Turnstile is usually invisible, and only takes room when it asks for a
      // click. The container gets its spacing only while there's a widget to
      // space, so the hidden one doesn't leave a gap
      const challenge = this.querySelector<HTMLElement>("[data-challenge]")!
      new ResizeObserver(([entry]) => {
        challenge.toggleAttribute("data-shown", entry.contentRect.height > 0)
      }).observe(challenge)

      const head = this.querySelector<HTMLElement>("[data-head]")!
      head.addEventListener("pointerdown", (event) => this.dragStart(event))
      head.addEventListener("pointermove", (event) => this.dragMove(event))
      head.addEventListener("pointerup", (event) => this.dragEnd(event))
      head.addEventListener("pointercancel", (event) => this.dragEnd(event))
    }

    /** Every trigger shows the same state, so any of them puts it away. */
    toggle(trigger: HTMLElement) {
      if (this.dialog.open) this.close()
      else this.open(trigger)
    }

    open(trigger: HTMLElement) {
      clearTimeout(this.closing)
      // Reopened before the last one finished leaving
      if (this.status === "sent") this.reset()
      this.trigger = trigger
      const isSheet = window.matchMedia(SHEET).matches
      // On a phone it takes the screen, so the page behind goes inert. On a
      // bigger screen it floats and the page stays usable
      if (!this.dialog.open) {
        // Floating, a click on the page is someone using the page, not
        // dismissing the composer
        if (isSheet) this.dialog.setAttribute("closedby", "any")
        else this.dialog.removeAttribute("closedby")
        if (isSheet) this.dialog.showModal()
        else this.dialog.show()
      }
      this.syncTriggers()

      // A focused field throws the phone's keyboard up while the sheet is
      // still rising, so there the first tap picks the field
      if (isSheet) {
        this.querySelector<HTMLElement>("[data-close]")!.focus({ preventScroll: true })
      } else {
        const fields = this.form.elements
        const from = fields.namedItem("from") as HTMLInputElement
        const message = fields.namedItem("message") as HTMLTextAreaElement
        // Pick up where the draft left off
        ;(from.value ? message : from).focus({ preventScroll: true })
      }

      this.prepareChallenge()
    }

    close() {
      if (!this.dialog.open) return
      const hadFocus = this.dialog.contains(document.activeElement)
      this.dialog.close()
      this.syncTriggers()
      // Hand focus back, unless the reader has already moved on
      if (hadFocus && this.trigger?.isConnected) this.trigger.focus({ preventScroll: true })
      if (this.status === "sent") this.closing = setTimeout(() => this.reset(), EXIT_MS)
    }

    reset() {
      clearTimeout(this.closing)
      this.form.reset()
      this.status = "idle"
      this.setMessage("")
      this.setLive("")
      this.render()
    }

    syncTriggers() {
      for (const trigger of document.querySelectorAll<HTMLElement>(TRIGGER)) {
        trigger.setAttribute("aria-haspopup", "dialog")
        trigger.setAttribute("aria-controls", "email-composer")
        trigger.setAttribute("aria-expanded", String(this.dialog.open))
      }
    }

    handleKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        event.preventDefault()
        this.close()
        return
      }

      // Safari ends an IME composition with an Enter that isn't flagged as
      // composing, only as key 229, so both are checked
      if (event.key !== "Enter" || event.isComposing || event.keyCode === 229) return

      if (event.metaKey || event.ctrlKey) {
        event.preventDefault()
        this.form.requestSubmit()
        return
      }

      // Return in a one-line field moves on, like the phone keyboard's "next",
      // instead of sending a half-written email
      const target = event.target
      if (target instanceof HTMLInputElement) {
        event.preventDefault()
        const next = FIELD_ORDER[FIELD_ORDER.indexOf(target.name) + 1]
        ;(this.form.elements.namedItem(next) as HTMLElement | null)?.focus()
      }
    }

    // --- Pulling the sheet down ------------------------------------------------

    dragStart(event: PointerEvent) {
      if (event.pointerType === "mouse" || !window.matchMedia(SHEET).matches) return
      if ((event.target as Element).closest("button")) return
      this.drag = { startY: event.clientY, lastY: event.clientY, lastAt: event.timeStamp, velocity: 0 }
      ;(event.currentTarget as HTMLElement).setPointerCapture(event.pointerId)
    }

    dragMove(event: PointerEvent) {
      const drag = this.drag
      if (!drag) return
      const elapsed = event.timeStamp - drag.lastAt
      if (elapsed > 0) drag.velocity = (event.clientY - drag.lastY) / elapsed
      drag.lastY = event.clientY
      drag.lastAt = event.timeStamp

      // Down it follows the finger; up it only gives a little, as if it's
      // already as tall as it goes
      const pulled = event.clientY - drag.startY
      const offset = pulled >= 0 ? pulled : -8 * Math.log1p(-pulled / 8)
      this.dialog.style.transition = "none"
      this.dialog.style.translate = `0 ${offset}px`
    }

    dragEnd(event: PointerEvent) {
      const drag = this.drag
      this.drag = null
      if (!drag) return

      // Back to the stylesheet, whose transition carries the sheet on from
      // where the finger left it: down and away, or back up
      this.dialog.style.transition = ""
      this.dialog.style.translate = ""
      const pulled = event.clientY - drag.startY
      const isFresh = event.timeStamp - drag.lastAt < 80
      const flicked = pulled > 16 && isFresh && drag.velocity > DISMISS_VELOCITY
      if (event.type === "pointerup" && (pulled > DISMISS_DISTANCE || flicked)) this.close()
    }

    // --- Turnstile -----------------------------------------------------------

    async prepareChallenge() {
      if (this.widgetId || !siteKey) return
      try {
        const turnstile = await loadTurnstile()
        if (this.widgetId) return
        const isDark = document.documentElement.classList.contains("theme-dark")
        this.widgetId = turnstile.render(this.querySelector<HTMLElement>("[data-challenge]")!, {
          sitekey: siteKey,
          action: TURNSTILE_ACTION,
          appearance: "interaction-only",
          size: "normal",
          theme: isDark ? "dark" : "light",
          // The token goes in the JSON body, not a hidden form field
          "response-field": false,
          callback: (token: string) => {
            this.token = token
            this.challengeFailed = false
            this.settleWaiting(token)
          },
          // Rarely, Cloudflare wants a click. The checkbox appears above Send
          "before-interactive-callback": () => {
            this.setMessage("Cloudflare wants a quick check first: tick the box above.")
          },
          "after-interactive-callback": () => {
            this.setMessage("")
          },
          "expired-callback": () => {
            this.token = null
          },
          "error-callback": () => {
            this.token = null
            this.challengeFailed = true
            this.settleWaiting(null)
            // Handled: tell Turnstile not to throw
            return true
          },
        })
      } catch {
        this.challengeFailed = true
        this.settleWaiting(null)
      }
    }

    settleWaiting(token: string | null) {
      const waiting = this.waiting
      this.waiting = []
      for (const resolve of waiting) resolve(token)
    }

    /** The current token, or waits for Turnstile to hand one over. */
    getToken(): Promise<string | null> {
      if (this.token) return Promise.resolve(this.token)
      if (!siteKey || (this.challengeFailed && !this.widgetId)) return Promise.resolve(null)

      if (this.challengeFailed && this.widgetId) this.refreshChallenge()
      else void this.prepareChallenge()
      return new Promise((resolve) => {
        const timeout = setTimeout(() => {
          this.waiting = this.waiting.filter((waiter) => waiter !== settle)
          resolve(null)
        }, CHALLENGE_TIMEOUT_MS)
        const settle = (token: string | null) => {
          clearTimeout(timeout)
          resolve(token)
        }
        this.waiting.push(settle)
      })
    }

    /** Tokens are single use: after every attempt, start on the next one. */
    refreshChallenge() {
      this.token = null
      this.challengeFailed = false
      if (this.widgetId) window.turnstile?.reset(this.widgetId)
    }

    // --- Sending -------------------------------------------------------------

    async send() {
      if (this.status !== "idle") return

      const fields = this.form.elements
      const from = fields.namedItem("from") as HTMLInputElement
      const message = fields.namedItem("message") as HTMLTextAreaElement

      if (!isEmailAddress(from.value.trim())) {
        this.setMessage("Add your email so I can write back.")
        from.focus()
        return
      }

      if (!hasText(message.value)) {
        this.setMessage("Write a message first.")
        message.focus()
        return
      }

      this.setMessage("")
      this.status = "sending"
      this.render()
      this.setLive("Sending your email")
      const minimum = wait(MIN_SENDING_MS)

      const token = await this.getToken()
      if (!token) {
        await minimum
        this.fail("Couldn't confirm you're a person.", { offerMailApp: true })
        this.refreshChallenge()
        return
      }

      const draft = Object.fromEntries(new FormData(this.form))

      try {
        const response = await fetch(CONTACT_PATH, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...draft, token }),
        })

        await minimum

        if (!response.ok) {
          const answer = (await response.json().catch(() => ({}))) as { error?: string }
          // A field the server didn't like, or too many emails: it says which
          const isVisitorFixable = [400, 403, 413, 429].includes(response.status)
          this.fail(answer.error ?? "That didn't go through.", { offerMailApp: !isVisitorFixable })
          return
        }

        this.querySelector("[data-sent-to]")!.textContent = from.value.trim()
        const hadFocus = this.dialog.contains(document.activeElement)
        this.status = "sent"
        this.render()
        this.setLive("Email sent")
        // The field that had focus is folding away; the close button is what's left to do
        if (hadFocus) this.querySelector<HTMLElement>("[data-close]")!.focus({ preventScroll: true })
        this.closing = setTimeout(() => this.close(), SENT_LINGER_MS)
      } catch {
        await minimum
        this.fail("That didn't go through.", { offerMailApp: true })
      } finally {
        this.refreshChallenge()
      }
    }

    fail(text: string, { offerMailApp = false } = {}) {
      this.status = "idle"
      this.render()
      this.setLive("")
      this.setMessage(text, offerMailApp)
    }

    // --- Rendering -----------------------------------------------------------

    render() {
      this.dialog.dataset.status = this.status
      const send = this.querySelector<HTMLButtonElement>("[data-send]")!
      send.setAttribute("aria-disabled", String(this.status !== "idle"))
      this.querySelector("[data-send-label]")!.textContent =
        this.status === "sending" ? "Sending…" : this.status === "sent" ? "Sent" : "Send"
      for (const field of this.form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        "input:not([name=fax]), textarea",
      )) {
        field.readOnly = this.status !== "idle"
      }
      const isSent = this.status === "sent"
      this.querySelector<HTMLElement>("[data-fields]")!.inert = isSent
      this.querySelector<HTMLElement>("[data-sent]")!.inert = !isSent
    }

    setMessage(text: string, offerMailApp = false) {
      const message = this.querySelector<HTMLElement>("[data-message]")!
      message.replaceChildren()
      this.dialog.toggleAttribute("data-has-message", Boolean(text))
      if (!text) return

      message.append(text)
      if (offerMailApp) {
        const link = document.createElement("a")
        link.href = CONTACT_MAILTO
        link.textContent = "your mail app"
        message.append(" Try again, or use ", link, ".")
      }
    }

    setLive(text: string) {
      this.querySelector("[data-live]")!.textContent = text
    }
  }

  if (!customElements.get("email-composer")) {
    customElements.define("email-composer", EmailComposer)
  }

  // Bound once, here, rather than per element: on navigation the router
  // briefly connects the incoming page's copy of the composer before swapping
  // the persisted one back in, and listeners bound by that copy would outlive
  // it. These always act on whichever composer is in the page.
  const composer = () => document.querySelector<EmailComposer>("email-composer")

  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>(TRIGGER)
    if (!trigger) return
    event.preventDefault()
    composer()?.toggle(trigger)
  })

  // The nav and footer are new elements after every navigation
  document.addEventListener("astro:page-load", () => composer()?.syncTriggers())

  // As a sheet it sits on the on-screen keyboard, so it follows the part of
  // the page that's still visible
  const viewport = window.visualViewport
  if (viewport) {
    const follow = () => {
      const dialog = composer()?.dialog
      if (!dialog) return
      const covered = window.innerHeight - viewport.height - viewport.offsetTop
      dialog.style.setProperty("--keyboard-inset", `${Math.max(0, Math.round(covered))}px`)
      dialog.style.setProperty("--visible-height", `${Math.round(viewport.height)}px`)
    }
    viewport.addEventListener("resize", follow)
    viewport.addEventListener("scroll", follow)
    document.addEventListener("astro:page-load", follow)
  }
</script>

<style>
  .composer {
    --keyboard-inset: 0px;

    position: fixed;
    inset: auto 1.5rem 1.5rem auto;
    z-index: 10000;
    width: min(30rem, calc(100vw - 3rem));
    max-height: calc(100dvh - 3rem);
    margin: 0;
    padding: 0;
    /* Never a scroll container itself: when space runs out, the message box
       shrinks and scrolls inside */
    overflow: hidden;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-lg);
    background: var(--gray-999);
    color: var(--gray-0);
    box-shadow:
      0 24px 48px -12px rgba(9, 11, 17, 0.35),
      var(--shadow-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);

    opacity: 0;
    translate: 0 0.75rem;
    transition:
      opacity 0.16s ease-out,
      translate 0.16s ease-out,
      display 0.16s allow-discrete,
      overlay 0.16s allow-discrete;
  }

  .composer[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
    translate: 0 0;
  }

  /* Only a modal (the phone sheet) has one */
  .composer::backdrop {
    background: rgba(9, 11, 17, 0);
    transition:
      background-color 0.2s ease-out,
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }

  .composer[open]::backdrop {
    background: rgba(9, 11, 17, 0.45);
  }

  @starting-style {
    .composer[open]::backdrop {
      background: rgba(9, 11, 17, 0);
    }
  }

  /* The page behind the sheet stays put */
  :global(html:has(#email-composer:modal)) {
    overflow: hidden;
  }

  @starting-style {
    .composer[open] {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .composer {
      transition: none;
    }
  }

  form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
  }

  .head,
  .foot,
  .sent-fold {
    flex: none;
  }

  /* The fields take what's left, and inside them the message box does */
  .fields-fold {
    flex: 1 1 auto;
    min-height: 0;
  }

  .fields-fold > .fold-inner {
    display: flex;
    flex-direction: column;
  }

  .row {
    flex: none;
  }

  .grabber {
    display: none;
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.625rem 0.625rem 1rem;
    background: var(--gray-900);
  }

  .title {
    margin: 0;
