---
import { site, SOCIAL_LINKS } from "../data/site"
import { BUILD } from "../utils/build"
import Link from "./Link.astro"

const currentYear = new Date().getFullYear()
const footerLinks = SOCIAL_LINKS.filter((link) =>
  ["GitHub", "LinkedIn"].includes(link.label),
)
---

<footer>
  <div class="group">
    <div class="credits">
      <p>
        Designed & Developed in Porto Alegre 🇧🇷 with <a
          href="https://astro.build/">Astro</a
        >&nbsp;🚀
      </p>
      <p>&copy; {currentYear} {site.fullName}</p>
    </div>
    <p class="build">
      Built <time datetime={BUILD.builtAt.toISOString()}>{BUILD.builtAtLabel} UTC</time>
      {
        BUILD.commit && (
          <>
            {" "}from{" "}
            <Link href={BUILD.commit.url} utm={false} title="This build's commit on GitHub">
              <code>{BUILD.commit.short}</code>
            </Link>
          </>
        )
      }
    </p>
  </div>
  <p class="socials">
    {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    <button type="button" class="email" data-email-composer>Email</button>
    <a href="/mcp/" title="Connect your AI assistant to this site">MCP</a>
  </p>
</footer>
<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: auto;
    padding: 3rem 2rem 3rem;
    text-align: center;
    color: var(--gray-400);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* :global so anchors rendered by Link.astro are styled too */
  footer :global(a),
  .email {
    color: var(--gray-400);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  footer :global(a:hover),
  footer :global(a:focus-visible),
  .email:hover,
  .email:focus-visible,
  .email[aria-expanded="true"] {
    text-decoration-color: currentColor;
  }

  .email {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .group,
  .credits {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .build {
    font-size: 0.75rem;
  }

  /* The blog's inline code chip; the footer is already mono, so no resize */
  .build code {
    padding: 0.125em 0.3em;
    border-radius: var(--radius-xs);
    background: var(--gray-900);
    color: var(--gray-0);
  }

  /* Baseline, not the default stretch: the row is as tall as the credits
     beside it, and a stretched button centres its label while links keep
     theirs at the top */
  .socials {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 50em) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2.5rem 5rem;
    }

    .credits {
      flex-direction: row;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .group {
      align-items: flex-start;
    }

    .socials {
      justify-content: flex-end;
    }
  }
</style>
