---
import Icon from "./Icon.astro"
import ThemeToggle from "./ThemeToggle.astro"
import type { iconPaths } from "./IconPaths"

interface NavbarMenuItem {
  label: string
  href: string
  shortcut?: string // Keyboard shortcut key (single letter)
  external?: boolean
}

export const NAVBAR_MENU_ITEMS: NavbarMenuItem[] = [
  { label: "Home", href: "/", shortcut: "h" },
  { label: "Blog", href: "/blog/", shortcut: "b" },
  { label: "Resume", href: "/resume/", shortcut: "r" },
  { label: "Travel", href: "/travel/", shortcut: "t" },
  { label: "Changelog", href: "/changelog/", shortcut: "c" },
]

/** Export navigation shortcuts for the ShortcutsManager */
export const NAV_SHORTCUTS = NAVBAR_MENU_ITEMS.filter(
  (item) => item.shortcut,
).map((item) => ({
  key: item.shortcut!,
  label: item.label,
  href: item.href,
  external: item.external,
}))

interface SocialMediaItem {
  label: string
  href: string
  icon: keyof typeof iconPaths
}

const SOCIAL_MEDIA_ITEMS: SocialMediaItem[] = [
  {
    label: "GitHub",
    href: "https://github.com/rafaeelaudibert",
    icon: "github-logo",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/rbaudibert/",
    icon: "linkedin-logo",
  },
  {
    label: "Email",
    href: "mailto:me@rafaaudibert.dev",
    icon: "envelope-simple",
  },
]

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "")
  if (pathname.at(0) !== "/") pathname = "/" + pathname
  if (pathname.at(-1) !== "/") pathname += "/"
  return pathname === href || (href !== "/" && pathname.startsWith(href))
}
---

<nav>
  <div class="menu-header">
    <a href="/" class="site-title">Rafa Audibert</a>
  </div>

  <ul class="nav-items">
    {
      NAVBAR_MENU_ITEMS.map(({ label, href, external, shortcut }) => (
        <li>
          <a
            aria-current={isCurrentPage(href) ? "page" : null}
            class:list={["link", { external }]}
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
          >
            {/* The purple highlight is its own element with one transition
                name, so the router slides it from the old page's link to the
                new one's instead of fading two highlights */}
            {isCurrentPage(href) && <span class="active" aria-hidden="true" transition:name="nav-active" />}
            {label}
            {external && <Icon icon="arrow-square-out" size="0.85em" />}
            {shortcut && (
              <kbd class="shortcut-hint" aria-hidden="true">
                {shortcut.toUpperCase()}
              </kbd>
            )}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="menu-footer">
    <div class="socials">
      {
        SOCIAL_MEDIA_ITEMS.map(({ href, icon, label }) => (
          <a href={href} class="social">
            <span class="sr-only">{label}</span>
            <Icon icon={icon} />
          </a>
        ))
      }
    </div>

    <div class="theme-toggle">
      <ThemeToggle />
    </div>
  </div>
</nav>

<style>
  /*
   * One layout, two arrangements. On phones: a header row with the title on
   * the left and the icons and theme toggle on the right, then the pill of
   * links on its own row, scrolling sideways if it has to. From 50em: the
   * three parts sit on one row, the pill centred.
   */
  /*
   * Phones: the pill of links floats fixed at the top of the viewport, and
   * the header row (title, icons, theme toggle) sits below the space it
   * takes. From 50em everything is one static row: title, pill, icons.
   */
  nav {
    z-index: 9999;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    /* Top padding reserves the floating pill's height plus its margins */
    padding: calc(var(--nav-offset)) 1.5rem 0;
    margin-bottom: 1.5rem;
    font-family: var(--font-brand);
    font-weight: 500;
  }

  .menu-header {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
  }

  .site-title {
    line-height: 1.1;
    color: var(--gray-0);
    text-decoration: none;
    white-space: nowrap;
  }

  /* The gradient stroke is a border-box background layer */
  .nav-items {
    position: fixed;
    top: 0.75rem;
    left: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    display: flex;
    gap: 0.125rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    font-size: 0.8125rem;
    line-height: 1.2;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background:
      radial-gradient(var(--gray-900), var(--gray-800) 150%) padding-box,
      var(--gradient-stroke) border-box;
    box-shadow: var(--shadow-md);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-items::-webkit-scrollbar {
    display: none;
  }

  .nav-items li {
    flex: 1 0 auto;
  }

  .link {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25em;
    padding: 0.5rem 0.5rem;
    border-radius: var(--radius-pill);
    color: var(--gray-300);
    text-decoration: none;
    white-space: nowrap;
    transition:
      color var(--theme-transition),
      background-color var(--theme-transition);
  }

  .link:hover,
  .link:focus-visible {
    color: var(--gray-100);
    background-color: var(--accent-subtle-overlay);
  }

  .link[aria-current="page"] {
    color: var(--accent-text-over);
  }

  .link[aria-current="page"]:hover,
  .link[aria-current="page"]:focus-visible {
    color: var(--accent-text-over);
    background-color: transparent;
  }

  .active {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--radius-pill);
    background-color: var(--accent-regular);
  }

  .menu-footer {
    --icon-size: 1.25rem;
    --icon-padding: 0.375rem;

    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .socials {
    display: flex;
    font-size: var(--icon-size);
  }

  /* Icons take the title's colour so they read over the gradient in both themes */
  .social {
    display: flex;
    padding: var(--icon-padding);
    text-decoration: none;
    color: var(--gray-0);
    transition: color var(--theme-transition);
  }

  .social:hover,
  .social:focus-visible {
    color: var(--accent-regular);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    margin-left: 0.25rem;
    height: calc(var(--icon-size) + 2 * var(--icon-padding));
  }

  @media (min-width: 50em) {
    nav {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1rem;
      padding: 2.5rem 5rem;
      margin-bottom: 3.5rem;
    }

    .site-title {
      font-size: var(--text-lg);
    }

    .nav-items {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      padding: 0.5rem 0.5625rem;
      font-size: var(--text-sm);
      overflow: visible;
    }

    .nav-items li {
      flex: none;
    }

    .link {
      padding: 0.5rem 1rem;
    }

    .menu-footer {
      --icon-size: var(--text-xl);

      justify-self: flex-end;
    }

    /* Tight desktops keep the toggle and drop the icons */
    .socials {
      display: none;
    }
  }

  @media (min-width: 60em) {
    .socials {
      display: flex;
    }
  }

  @media (forced-colors: active) {
    .link[aria-current="page"] {
      color: SelectedItem;
    }
  }

  @media print {
    .nav-items {
      position: static;
    }
  }

  /* Keyboard shortcut hints */
  .shortcut-hint {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Start collapsed - no space taken */
    width: 0;
    height: 1.25rem;
    padding: 0;
    margin-left: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    line-height: 1;
    color: var(--accent-text-over);
    background: var(--accent-regular);
    border-radius: var(--radius-xs);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    opacity: 0;
    transform: scale(0.8);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      width 0.15s ease,
      padding 0.15s ease,
      margin-left 0.15s ease;
    pointer-events: none;
  }

  /* Show hints when Alt is held (class added by JS) */
  :global(.shortcuts-active) .shortcut-hint {
    width: 1.25rem;
    padding: 0 0.25rem;
    margin-left: 0.375rem;
    opacity: 1;
    transform: scale(1);
  }

  /* Hide on mobile - shortcuts don't work well there */
  @media (max-width: 50em) {
    .shortcut-hint {
      display: none;
    }
  }

  /* Hide when printing */
  @media print {
    .shortcut-hint {
      display: none !important;
    }
  }
</style>
