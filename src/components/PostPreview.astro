---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"
import { convertToHumanReadableDate } from "../utils/date"

interface Props {
  post: CollectionEntry<"blog">
}

const pathFor = (path: string) => `../assets/blog/${path}`

const { data, id } = Astro.props.post
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/blog/*.{png,jpg}"
)
if (!images[pathFor(data.img)])
  throw new Error(
    `"${data.img}" does not exist in glob: "../assets/blog/*.{png,jpg}"`
  )
---

<a class="card" href={`/blog/${id}`}>
  <span class="label">
    <span class="title">{data.title}</span>
    <time class="text-meta" datetime={data.publishDate.toISOString()}>
      {convertToHumanReadableDate(data.publishDate)}
    </time>
  </span>
  <Image src={images[pathFor(data.img)]()} alt={data.img_alt || ""} />
</a>

<style>
  .card {
    display: grid;
    grid-template: auto 1fr / auto 1fr;
    height: 11rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: box-shadow var(--theme-transition);
  }

  .card:hover,
  .card:focus {
    box-shadow: var(--shadow-md);
  }

  .card:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }

  .label {
    grid-area: 1 / 1 / 2 / 2;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--gray-999);
    border-radius: 0.375rem;
  }

  .title {
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.3;
    color: var(--gray-100);
    text-wrap: balance;
  }

  img {
    grid-area: 1 / 1 / 3 / 3;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 50em) {
    .card {
      height: 22rem;
      border-radius: 1.5rem;
    }

    .label {
      border-radius: 0.9375rem;
    }
  }
</style>
