---
import { resolveChangelogEntry } from "../../data/changelogPhotos"

interface Props {
  year?: number | undefined
  month: string
  wip?: boolean
  entryId?: string
}

const { year, month, wip = false } = Astro.props
const { entryId: resolvedEntryId, photos } = resolveChangelogEntry(month, year)
const entryId = Astro.props.entryId ?? resolvedEntryId
---

<article class="entry">
  <div class="entry-meta">
    <h3 class="month eyebrow">{month}{wip ? " · in progress 🚧" : ""}</h3>

    {
      photos.length > 0 && (
        <div class="entry-photos">
          {photos.map((photo, index) => (
            <button
              type="button"
              class="photo-thumb"
              data-gallery-open={entryId}
              data-image-index={index}
              aria-label={`View photo: ${photo.alt}`}
            >
              <img
                src={photo.placeholderSrc}
                alt=""
                aria-hidden="true"
                class="photo-thumb-image"
                width={48}
                height={48}
                decoding="async"
                loading="eager"
              />
            </button>
          ))}
        </div>
      )
    }
  </div>

  <div class:list={["content", "text-reading", { "wip-content": wip }]}>
    <slot />
  </div>
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Month and photos: a row above the text, a column beside it on wide screens */
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  /* Months are the timeline's dates, so they read as metadata */
  .month {
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.08em;
  }

  .entry-photos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .photo-thumb {
    display: block;
    padding: 0;
    border: 1px solid var(--gray-700);
    border-radius: var(--radius-sm);
    background: var(--gray-800);
    cursor: pointer;
    overflow: hidden;
    line-height: 0;
    transition: border-color var(--theme-transition);
  }

  .photo-thumb:hover,
  .photo-thumb:focus-visible {
    border-color: var(--accent-regular);
  }

  .photo-thumb-image {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    max-width: none;
    object-fit: cover;
  }

  .content {
    color: var(--gray-200);

    p:not(:last-child) {
      margin-bottom: 1rem;
    }

    a {
      text-decoration: 1px solid underline transparent;
      text-underline-offset: 0.25em;
      transition: text-decoration-color var(--theme-transition);

      &:hover,
      &:focus-visible {
        text-decoration-color: currentColor;
      }
    }
  }

  .wip-content {
    border: 1px dashed var(--gray-600);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  @media (min-width: 50em) {
    .entry {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }

    .entry-meta {
      align-self: start;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 0.5rem;
      padding-top: 0.15rem;
    }

    .entry-photos {
      max-width: 7.5rem;
    }

    .content {
      max-width: 68ch;
      font-size: 1.0625rem;
    }
  }
</style>
