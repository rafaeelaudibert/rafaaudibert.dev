---
/**
 * The header the travel and changelog pages open with: eyebrow, title, dek
 * and a "last updated" line on the left, a large photo on the right,
 * stacked on narrow screens. `media` is the photo. The date is the build
 * date, so it changes on deploy only.
 */
interface Props {
  title: string
  eyebrow?: string
  dek?: string
}

const { title, eyebrow, dek } = Astro.props
const lastUpdated = new Date().toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
})
---

<header class="split-header">
  <div class="intro">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="title">{title}</h1>
    {dek && <p class="text-dek">{dek}</p>}
    <p class="text-meta">Last updated {lastUpdated}</p>
  </div>
  <div class="media">
    <slot name="media" />
  </div>
</header>

<style>
  .split-header {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .title {
    color: var(--gray-0);
  }

  .text-meta {
    margin-top: 0.5rem;
  }

  .media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 50em) {
    .split-header {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
      gap: 3rem;
      padding-top: 2rem;
    }
  }
</style>
