---
/**
 * The resume's header card: a frosted panel over the page gradient, so the
 * name and role read clearly in both themes.
 *
 * Slots: `media` (a picture on the left), the default slot (a line of facts
 * under the dek) and `aside` (actions on the right). In print it collapses to
 * a plain row with no card.
 */
interface Props {
  title: string
  eyebrow?: string
  dek?: string
}

const { title, eyebrow, dek } = Astro.props
---

<header class="page-header">
  {Astro.slots.has("media") && <slot name="media" />}

  <div class="identity">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="title">{title}</h1>
    {dek && <p class="dek text-dek">{dek}</p>}
    <slot />
  </div>

  {
    Astro.slots.has("aside") && (
      <div class="aside">
        <slot name="aside" />
      </div>
    )
  }
</header>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-lg);
    background-color: color-mix(in srgb, var(--gray-999) 70%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: var(--shadow-md);
  }

  .identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .title {
    font-size: clamp(2rem, 1.4rem + 2vw, 3rem);
    color: var(--gray-0);
  }

  .dek {
    margin: 0;
  }

  .aside {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  @media (min-width: 50em) {
    .page-header {
      flex-direction: row;
      text-align: left;
      gap: 2rem;
      padding: 2rem;
    }

    .identity {
      flex: 1;
      align-items: flex-start;
    }

    .aside {
      flex-direction: column;
      align-self: stretch;
      justify-content: center;
      align-items: stretch;
      min-width: 9rem;
    }
  }

  @media print {
    .page-header {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 0.75rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      backdrop-filter: none;
      box-shadow: none;
      page-break-after: avoid;
    }

    .identity {
      align-items: flex-start;
      gap: 0.125rem;
    }

    .eyebrow,
    .aside {
      display: none;
    }

    .title {
      font-size: 18pt;
      color: #1a1a1a;
    }

    .dek {
      font-size: 12pt;
      color: #333;
    }
  }
</style>
