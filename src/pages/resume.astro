---
import BaseLayout from "../layouts/BaseLayout.astro"

import Icon from "../components/Icon.astro"
import KeyboardShortcut from "../components/KeyboardShortcut.astro"
import Link from "../components/Link.astro"
import PageHeader from "../components/PageHeader.astro"

import work from "../assets/work.jpg"

import { Image } from "astro:assets"

import {
  getBackgroundContent,
  yearsOfExperience,
  PAST_EXPERIENCES,
  EDUCATION_AND_ACHIEVEMENTS,
  LANGUAGES,
  TECHNOLOGIES,
} from "../data/resume"
import { COMPANY_LOGOS, COMPANY_LOGOS_DARK } from "../data/companyLogos"
import { site, SOCIAL_LINKS } from "../data/site"

const EMAIL = "me@rafaaudibert.dev"
const profiles = SOCIAL_LINKS.filter(({ label }) => label === "GitHub" || label === "LinkedIn")
const iconFor = { GitHub: "github-logo", LinkedIn: "linkedin-logo" } as const
---

<BaseLayout title="Resume | Rafa Audibert" description="Rafa Audibert's Resume">
  <div class="stack gap-20 mb-4">
    <main class="wrapper resume">
      <PageHeader eyebrow="Resume" title={site.fullName} dek="Senior Product Engineer">
        <Image slot="media" src={work} alt="Rafael Audibert at his desk" class="profile-image" width={240} height={300} densities={[1, 2]} />

        <ul class="facts text-meta">
          <li>{site.location}</li>
          <li>{yearsOfExperience()}+ years of experience</li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        </ul>

        <div slot="aside" class="actions">
          <button type="button" class="action action-primary" data-print>
            Save as PDF
            <KeyboardShortcut keys={["Ctrl/Cmd", "P"]} class="action-shortcut" />
          </button>
          {
            profiles.map(({ label, href }) => (
              <a class="action" href={href} target="_blank" rel="noopener noreferrer">
                <Icon icon={iconFor[label]} size="1.1em" />
                {label}
                <span class="sr-only">(opens in new tab)</span>
              </a>
            ))
          }
        </div>
      </PageHeader>

      <section class="labelled-section" aria-labelledby="background">
        <h2 class="section-title" id="background">Background</h2>
        <div class="content text-reading">
          {getBackgroundContent().map((content) => <p set:html={content} />)}
        </div>
      </section>

      <section class="labelled-section" aria-labelledby="experience">
        <h2 class="section-title" id="experience">Experience</h2>
        <ol class="content jobs">
          {
            PAST_EXPERIENCES.map((experience) => (
              <li class="job" data-company={experience.company}>
                <div class="job-header">
                  <span class="logo">
                    <Image
                      src={COMPANY_LOGOS[experience.company]}
                      alt=""
                      width={48}
                      height={48}
                      class:list={{ "logo-light": COMPANY_LOGOS_DARK[experience.company] }}
                    />
                    {COMPANY_LOGOS_DARK[experience.company] && (
                      <Image src={COMPANY_LOGOS_DARK[experience.company]!} alt="" width={48} height={48} class="logo-dark" />
                    )}
                  </span>
                  <div class="job-heading">
                    <h3 class="job-role">
                      {experience.role} <span class="at">at</span>{" "}
                      <Link utm={false} href={experience.href}>{experience.company}</Link>
                    </h3>
                    <span class="dates text-meta">
                      {experience.startDate} – {experience.endDate}
                    </span>
                  </div>
                </div>

                <ul class="bullets text-reading">
                  {experience.bulletPoints.map((bulletPoint) => (
                    <li set:html={bulletPoint} />
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="labelled-section" aria-labelledby="education">
        <h2 class="section-title" id="education">Education &amp; Achievements</h2>
        <ul class="content timeline text-reading">
          {
            EDUCATION_AND_ACHIEVEMENTS.map((content) => (
              <li>
                <span class="year text-meta">{content.year}</span>
                <span set:html={content.description} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="labelled-section" aria-labelledby="languages">
        <h2 class="section-title" id="languages">Languages</h2>
        <ul class="content languages">
          {
            LANGUAGES.map((language) => (
              <li>
                <span class="language-row">
                  <span class="language">
                    <span class="flag" aria-hidden="true">{language.flag}</span> {language.language}
                  </span>
                  <abbr class="cefr text-meta" title="CEFR level">{language.cefr}</abbr>
                </span>
                <span class="level text-meta">{language.level}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="labelled-section" aria-labelledby="technologies">
        <h2 class="section-title" id="technologies">Technologies</h2>
        <div class="content">
          <p class="help-text text-meta">
            In no particular order. <KeyboardShortcut keys={["Ctrl/Cmd", "F"]} /> is your friend.
          </p>
          <dl class="tech">
            {
              TECHNOLOGIES.map((technology) => (
                <div class="tech-group">
                  <dt class="eyebrow">{technology.type}</dt>
                  <dd>
                    <ul class="chips">
                      {technology.technologies.map((name) => <li>{name}</li>)}
                    </ul>
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>
    </main>
  </div>

</BaseLayout>

<script>
  // Bound on every page load: the router swaps the DOM without re-running scripts
  document.addEventListener("astro:page-load", () => {
    document.querySelector("[data-print]")?.addEventListener("click", () => window.print())
  })

  // Hook the browser's own print event rather than the button, so the File
  // menu, Ctrl/Cmd+P and mobile share sheets are counted too.
  window.addEventListener("beforeprint", () => {
    window.posthog?.capture("resume printed")
  })

  // Safari does not fire beforeprint, so fall back to the print media query.
  if (!("onbeforeprint" in window) && window.matchMedia) {
    const printQuery = window.matchMedia("print")
    printQuery.addEventListener("change", (e) => {
      if (e.matches) window.posthog?.capture("resume printed")
    })
  }
</script>

<style>
  .resume {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .profile-image {
    width: 10rem;
    height: 12.5rem;
    border-radius: var(--radius-md);
    object-fit: cover;
    flex-shrink: 0;
  }

  .facts {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem 0.75rem;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .facts a {
    color: inherit;
    text-decoration-color: var(--gray-600);
    text-underline-offset: 0.2em;
  }

  .facts a:hover,
  .facts a:focus-visible {
    color: var(--gray-0);
  }

  .actions {
    display: contents;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-sm);
    background-color: var(--gray-999);
    color: var(--gray-100);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--theme-transition),
      border-color var(--theme-transition),
      color var(--theme-transition);
  }

  .action:hover,
  .action:focus-visible {
    border-color: var(--accent-regular);
    color: var(--gray-0);
  }

  .action-primary {
    border-color: var(--accent-regular);
    background-color: var(--accent-regular);
    color: var(--accent-text-over);
  }

  .action-primary:hover,
  .action-primary:focus-visible {
    background-color: var(--accent-dark);
    border-color: var(--accent-dark);
    color: var(--accent-text-over);
  }

  /* The key caps take the button's colour rather than the grey default */
  .action-shortcut {
    margin-left: 0.125rem;
  }

  .action-primary :global(.key) {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    border-bottom-color: rgba(255, 255, 255, 0.5);
    color: inherit;
    box-shadow: none;
  }

  .action-primary :global(.key-separator) {
    color: rgba(255, 255, 255, 0.7);
  }

  .content {
    max-width: 72ch;
    min-width: 0;
  }

  .content :global(strong),
  .content :global(b) {
    color: var(--gray-0);
    font-weight: 600;
  }

  .content :global(a) {
    color: var(--link-color);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .content :global(a:hover),
  .content :global(a:focus-visible) {
    text-decoration-color: currentColor;
  }

  .text-reading p + p {
    margin-top: 1rem;
  }

  /* Experience */
  .jobs {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    padding: 0;
    list-style: none;
  }

  .job-header {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-sm);
    background-color: var(--gray-999);
  }

  .logo img {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Only one of a logo's light/dark variants shows at a time */
  .logo .logo-dark,
  :global(.theme-dark) .logo .logo-light {
    display: none;
  }

  :global(.theme-dark) .logo .logo-dark {
    display: block;
  }

  .job-heading {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.125rem 1rem;
    min-width: 0;
  }

  .job-role {
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .job-role .at {
    font-weight: 500;
    color: var(--gray-400);
  }

  .job-role :global(a) {
    color: var(--gray-0);
  }

  .dates {
    white-space: nowrap;
  }

  .bullets {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.875rem 0 0;
    padding-left: 1.25rem;
    list-style: disc; /* nested in the jobs list, which would make it circle */
  }

  .bullets li::marker {
    color: var(--accent-regular);
  }

  /* Education */
  .timeline {
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--gray-800);
  }

  .timeline li:first-child {
    padding-top: 0;
  }

  .timeline .year {
    color: var(--gray-0);
    padding-top: 0.3em;
  }

  /* Languages */
  .languages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .languages li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-md);
    background-color: var(--gray-999_40);
  }

  .language {
    font-weight: 600;
    color: var(--gray-0);
  }

  .flag {
    margin-right: 0.125rem;
  }

  .language-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .cefr {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-xs);
    color: var(--gray-100);
    font-weight: 500;
    text-decoration: none;
  }

  /* Technologies */
  .help-text {
    margin-bottom: 1.25rem;
  }

  .tech {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .tech dt {
    display: block;
    list-style: none;
    margin-top: 0;
    padding-top: 0.2em;
  }

  .tech-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tech dd {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-sm);
    background-color: var(--gray-999_40);
    font-size: 0.875rem;
    color: var(--gray-100);
  }

  @media (min-width: 50em) {
    .resume {
      gap: 3.5rem;
    }

    .profile-image {
      width: 7.5rem;
      height: 9.5rem;
    }

    .facts {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
    }

    .facts li + li::before {
      content: "·";
      margin-right: 0.75rem;
      color: var(--gray-500);
    }

    .actions {
      justify-content: flex-start;
    }

    .action {
      justify-content: center;
    }

    .content {
      font-size: 1.0625rem;
    }

    .tech-group {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1rem;
      align-items: baseline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action,
    .content :global(a) {
      transition: none;
    }
  }

  /* Print: a plain one-column document in black on white */
  @media print {
    :global(nav),
    :global(footer),
    :global(aside),
    .help-text,
    /* The printed resume stops at the last three roles */
    .job[data-company="FEENG/UFRGS"] {
      display: none !important;
    }

    :global(body) {
      background: white !important;
      color: #1a1a1a !important;
      font-size: 10pt;
      line-height: 1.35;
    }

    :global(.backgrounds) {
      background: none !important;
    }

    .stack {
      gap: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .wrapper {
      max-width: none !important;
      padding: 0.45in 0.55in !important;
      margin: 0 !important;
    }

    .resume {
      gap: 0.5rem;
    }

    .profile-image {
      width: 60px;
      height: 75px;
      border-radius: 0;
    }

    .facts {
      flex-direction: row;
      flex-wrap: wrap;
      margin-top: 0.25rem;
      color: #333;
    }

    .facts li + li::before {
      content: "·";
      margin-right: 0.75rem;
    }

    section {
      display: block;
      padding-top: 0.5rem;
      border-top: 0;
      color: #1a1a1a;
      page-break-inside: avoid;
    }

    .section-title {
      position: static;
      font-size: 12pt;
      color: #1a1a1a;
      border-bottom: 1pt solid #1a1a1a;
      padding-bottom: 2pt;
      margin-bottom: 0.375rem;
      page-break-after: avoid;
    }

    .content {
      max-width: none;
      font-size: 10pt;
    }

    .text-reading p + p {
      margin-top: 0.5rem;
    }

    .content :global(strong),
    .content :global(b),
    .job-role :global(a),
    .language,
    .timeline .year {
      color: #1a1a1a;
    }

    .jobs {
      gap: 0.5rem;
    }

    .job {
      page-break-inside: avoid;
    }

    .logo {
      width: 16px;
      height: 16px;
      border: 0;
      background: none;
    }

    .logo img {
      width: 16px;
      height: 16px;
    }

    /* Paper is white, so always print the light logo */
    :global(.theme-dark) .logo .logo-light {
      display: block;
    }

    .logo .logo-dark {
      display: none !important;
    }

    .job-role {
      font-size: 11pt;
    }

    .job-role .at,
    .dates,
    .level {
      color: #444;
    }

    .bullets {
      gap: 0;
      margin-top: 0.125rem;
    }

    .bullets li::marker {
      color: #1a1a1a;
    }

    .timeline li {
      padding: 0.125rem 0;
      border-bottom: 0;
    }

    .languages {
      display: block;
    }

    .languages li {
      display: inline;
      padding: 0;
      border: 0;
      background: none;
    }

    .languages li:not(:last-child)::after {
      content: " · ";
    }

    .language-row {
      display: inline;
    }

    .cefr {
      padding: 0;
      border: 0;
      color: #444;
    }

    .cefr::before {
      content: " ";
    }

    .level::before {
      content: " (";
    }

    .level::after {
      content: ")";
    }

    .tech {
      gap: 0.25rem;
    }

    .tech-group {
      display: block;
    }

    .tech-group dt {
      display: inline;
      font-family: var(--font-body);
      font-size: 11pt;
      font-weight: 600;
      text-transform: none;
      letter-spacing: 0;
      color: #1a1a1a;
    }

    .tech-group dt::after {
      content: ": ";
    }

    .tech dd,
    .chips {
      display: inline;
    }

    .chips li {
      display: inline;
      padding: 0;
      border: 0;
      background: none;
      font-size: 11pt;
      color: #1a1a1a;
    }

    .chips li:not(:last-child)::after {
      content: ", ";
    }

    /* Links print as plain text with the address after them */
    :global(a) {
      color: #1a1a1a !important;
      text-decoration: none !important;
    }

    .content :global(a[href^="http"])::after {
      content: " (" attr(href) ")";
      font-size: 0.8em;
      color: #444;
    }

    * {
      box-shadow: none !important;
    }
  }
</style>
