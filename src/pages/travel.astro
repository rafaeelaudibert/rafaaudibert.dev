---
import BaseLayout from "../layouts/BaseLayout.astro"
import TravelGlobe from "../components/TravelGlobe"
import TravelGallery from "../components/TravelGallery"
import { Image } from "astro:assets"
import SplitHeader from "../components/SplitHeader.astro"
import travelHero from "../assets/travel-hero.jpg"
import {
  COUNTRY_CODE_TO_LONG_NAME,
  COUNTRIES_GEOMETRY,
  countryCodeToFlag,
} from "../data/countries"
import {
  getVisitedCountries,
  getVisitedCountriesTimeline,
  AIRPORTS,
  FLIGHTS,
  type AirportCode,
} from "../data/travel"
import { imagesByCountry } from "../data/travelPhotos"
import { joinerWithAnd } from "../utils/string"

const VISITED_COUNTRIES_TIMELINE = getVisitedCountriesTimeline()
const VISITED_COUNTRIES = getVisitedCountries()

// Get unique countries with earliest visit year
type VisitedCountryWithYears = (typeof VISITED_COUNTRIES_TIMELINE)[number] & {
  years: Set<number>
}
const uniqueCountries = VISITED_COUNTRIES_TIMELINE.reduce((acc, country) => {
  const existing = acc.find((c) => c.code === country.code)
  if (existing) {
    return acc.map((c) =>
      c.code === country.code
        ? { ...c, years: new Set([...c.years, country.year]) }
        : c,
    )
  }

  return [...acc, { ...country, years: new Set([country.year]) }]
}, [] as VisitedCountryWithYears[])

const uniqueContinents = COUNTRIES_GEOMETRY.features.reduce(
  (acc, country: any) => {
    if (VISITED_COUNTRIES.has(country.properties.ISO_A2)) {
      acc.add(country.properties.CONTINENT)
    }
    return acc
  },
  new Set<string>(),
)

// Compute globe markers from unique airports in flights
const airportCodes = new Set<string>()
FLIGHTS.forEach((f) => {
  airportCodes.add(f.from)
  airportCodes.add(f.to)
})
const markers = (Array.from(airportCodes) as Array<AirportCode>).map((code) => {
  const airport = AIRPORTS[code]
  const years = [
    ...new Set(
      FLIGHTS.filter((f) => f.from === code || f.to === code).map(
        (f) => f.year,
      ),
    ),
  ].sort()
  return {
    location: airport.location as [number, number],
    size: 0.03,
    id: code,
    label: airport.name.split("-")[0],
    countryCode: airport.countryCode,
    fullName: airport.name,
    countryName:
      COUNTRY_CODE_TO_LONG_NAME[airport.countryCode] ?? airport.countryCode,
    flag: countryCodeToFlag(airport.countryCode),
    years,
  }
})

// Compute arcs from flights
const arcs = FLIGHTS.map((f) => ({
  from: AIRPORTS[f.from].location as [number, number],
  to: AIRPORTS[f.to].location as [number, number],
  fromCode: f.from,
  toCode: f.to,
}))

---

<BaseLayout
  title="Travel | Rafa Audibert"
  description="Rafa Audibert's Travel Journey - Countries visited around the world"
>
  <div class="stack gap-20 mb-4">
    <main class="wrapper travel">
      <div class="travel-header">
        <SplitHeader eyebrow="Travel" title="My Travel Journey" dek="Exploring the world, one flight at a time.">
          <Image
            slot="media"
            src={travelHero}
            alt="An aeroplane wing over a sea of clouds, with the ocean far below"
            widths={[480, 800, 1200]}
            sizes="(min-width: 50em) 40vw, 100vw"
            loading="eager"
          />
        </SplitHeader>

        <ul class="stat-strip">
          <li class="stat">
            <span class="stat-number">{uniqueCountries.length}</span>
            <span class="stat-label eyebrow">Countries and territories</span>
          </li>
          <li class="stat">
            <span class="stat-number">{((uniqueCountries.length / 210) * 100).toFixed(1)}%</span>
            <span class="stat-label eyebrow">Of the world</span>
          </li>
          <li class="stat">
            <span class="stat-number">{uniqueContinents.size}</span>
            <span class="stat-label eyebrow">Continents</span>
          </li>
          <li class="stat">
            <span class="stat-number">{FLIGHTS.length}</span>
            <span class="stat-label eyebrow">Flights</span>
          </li>
        </ul>
      </div>

      <TravelGlobe
        client:visible
        markers={markers}
        arcs={arcs}
        imagesByCountry={imagesByCountry}
      />

      <section class="labelled-section" aria-labelledby="countries">
        <h2 class="section-title" id="countries">Countries I've explored</h2>
        <div class="countries-grid">
          {
            uniqueCountries.map((country) => {
              const countryName = COUNTRY_CODE_TO_LONG_NAME[country.code]
              const countryEmoji = countryCodeToFlag(country.code)
              const countryYears = Array.from(country.years)
              const manyVisits = countryYears.length > 1
              const hasImages = (imagesByCountry[country.code]?.length ?? 0) > 0

              return (
                <div
                  class:list={["country-card", { "has-images": hasImages }]}
                  data-country={country.code}
                  data-country-name={countryName}
                  role={hasImages ? "button" : undefined}
                  tabindex={hasImages ? "0" : undefined}
                  title={`Visited in: ${joinerWithAnd(Array.from(country.years))}`}
                >
                  <span class="flag">{countryEmoji}</span>
                  <div class="country-info">
                    <span class="name">{countryName}</span>
                    <span class="year">
                      {countryYears.length === 1
                        ? country.year
                        : countryYears.length === 2
                          ? `${countryYears[0]} and ${countryYears[1]}`
                          : `${countryYears[0]} and more`}
                    </span>
                  </div>
                  {hasImages && (
                    <span class="camera-icon" aria-hidden="true">
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
                        <circle cx="12" cy="13" r="4" />
                      </svg>
                    </span>
                  )}
                  {manyVisits && (
                    <div class="years-tooltip">
                      <div class="tooltip-text">
                        <div class="tooltip-title">Visited in:</div>
                        <div class="tooltip-years">
                          {joinerWithAnd(countryYears)}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              )
            })
          }
        </div>
      </section>

      <section class="labelled-section" aria-labelledby="bucket-list">
        <h2 class="section-title" id="bucket-list">Bucket list</h2>
        <div class="bucket-list">
          <p class="bucket-list-subtitle text-reading">
            Places I'd love to visit at some point in my life — not necessarily where I'm heading next, but destinations I dream about.
          </p>
          <div class="bucket-list-grid">
            {(["AQ", "AT", "CN", "CO", "NO", "ZA"] as const).map((code) => (
              <div class="bucket-list-card">
                <span class="flag">{countryCodeToFlag(code)}</span>
                <span class="name">{COUNTRY_CODE_TO_LONG_NAME[code]}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <TravelGallery
        client:idle
        imagesByCountry={imagesByCountry}
        countryMeta={Object.fromEntries(
          Object.keys(imagesByCountry).map((code) => [
            code,
            {
              name: COUNTRY_CODE_TO_LONG_NAME[
                code as keyof typeof COUNTRY_CODE_TO_LONG_NAME
              ],
              flag: countryCodeToFlag(code),
            },
          ]),
        )}
      />
    </main>
  </div>
</BaseLayout>

<script>
  document.querySelectorAll(".country-card.has-images").forEach((card) => {
    card.addEventListener("click", () => {
      const countryCode = card.getAttribute("data-country")
      const countryName = card.getAttribute("data-country-name")
      window.posthog?.capture("photo card clicked", { country: countryCode, country_name: countryName })
      document.dispatchEvent(
        new CustomEvent("travel:open-gallery", {
          detail: { countryCode, countryName },
        }),
      )
    })
  })
</script>

<style>
  .travel {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Header: the shared split header, then the numbers as a strip */
  .travel-header {
    display: flex;
    flex-direction: column;
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 2.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--gray-800);
    list-style: none;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  /* Counts are data: mono numerals */
  .stat-number {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent-regular);
  }

  .countries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;
  }

  .country-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--gray-999_40);
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    position: relative;
  }

  .country-card.has-images:hover,
  .country-card.has-images:focus-visible {
    border-color: var(--accent-regular);
  }

  .country-card.has-images {
    cursor: pointer;
  }

  .flag {
    font-size: 1.5rem;
  }

  .country-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .name {
    font-weight: 600;
    color: var(--gray-0);
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gray-400);
  }

  .camera-icon {
    color: var(--gray-400);
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  .country-card:hover .camera-icon {
    opacity: 1;
  }

  .years-tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gray-900);
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    white-space: normal;
    max-width: 250px;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
    z-index: 10;
    margin-bottom: 0.5rem;
    text-align: center;
    line-height: 1.4;
  }

  .years-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--gray-900);
  }

  .country-card:hover .years-tooltip {
    opacity: 1;
    visibility: visible;
  }

  .tooltip-text {
    font-size: var(--text-sm);
    color: var(--gray-0);
  }

  .tooltip-title {
    font-weight: 600;
    margin-bottom: 0.25rem;
    color: var(--gray-200);
  }

  .tooltip-years {
    font-family: var(--font-mono);
    color: var(--gray-0);
    word-wrap: break-word;
    hyphens: auto;
  }

  .bucket-list-subtitle {
    max-width: 60ch;
    color: var(--gray-300);
    margin-bottom: 1.25rem;
  }

  .bucket-list-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.75rem;
  }

  .bucket-list-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--gray-999_40);
    border: 1px dashed var(--gray-700);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
    opacity: 0.7;
  }

  .bucket-list-card:hover {
    opacity: 1;
  }

  @media (min-width: 50em) {
    .stat-strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }

    .stat + .stat {
      padding-left: 2rem;
      border-left: 1px solid var(--gray-800);
    }
  }
</style>
