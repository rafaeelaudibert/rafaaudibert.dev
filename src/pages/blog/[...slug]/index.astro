---
import { type CollectionEntry, getCollection } from "astro:content"

import BaseLayout from "../../../layouts/BaseLayout.astro"

import Icon from "../../../components/Icon.astro"
import { render } from "astro:content"
import { Image } from "astro:assets"
import { convertToHumanReadableDate } from "../../../utils/date"

interface Props {
  entry: CollectionEntry<"blog">
}

// This is a dynamic route that generates a page for every Markdown file in src/content/
// Read more about dynamic routes and this `getStaticPaths` function in the Astro docs:
// https://docs.astro.build/en/core-concepts/routing/#dynamic-routes
export async function getStaticPaths() {
  const blog = await getCollection("blog")
  return blog.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)

const pathFor = (path: string) => `../../../assets/blog/${path}`

const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/blog/*.{png,jpg}"
)
if (!images[pathFor(entry.data.img)])
  throw new Error(
    `"${entry.data.img}" does not exist in glob: "../../../assets/blog/*.{png,jpg}"`
  )

// Rough reading time: drop MDX imports, tags and code fences before counting words
const words = (entry.body ?? "")
  .replace(/^import .*$/gm, "")
  .replace(/```[\s\S]*?```/g, "")
  .replace(/<[^>]+>/g, " ")
  .split(/\s+/)
  .filter(Boolean).length
const readingMinutes = Math.max(1, Math.round(words / 230))

// The contents rail lists the top-level sections only. Posts differ in which
// level they start at (some open with ###), so use the shallowest one present.
const topDepth = Math.min(...headings.map((h) => h.depth))
const sections = headings.filter((h) => h.depth === topDepth)
const showContents = sections.length >= 3
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={`${Astro.site}blog/${entry.id}/og.png`}
  type="article"
>
  <div class="stack gap-20">
    <main class="layout">
      <header class="head">
        <a class="back-link" href="/blog/"><Icon icon="arrow-left" /> All posts</a>
        <p class="meta text-meta">
          <time datetime={entry.data.publishDate.toISOString()}>
            {convertToHumanReadableDate(entry.data.publishDate)}
          </time>
          <span aria-hidden="true">·</span>
          {readingMinutes} min read
        </p>
        <h1>{entry.data.title}</h1>
        <p class="dek text-dek">{entry.data.description}</p>
        <ul class="tags" aria-label="Tags">
          {entry.data.tags.map((t) => <li>{t}</li>)}
        </ul>
      </header>

      {
        entry.data.img && (
          <Image
            class="cover"
            src={images[pathFor(entry.data.img)]()}
            alt={entry.data.img_alt || ""}
            loading="eager"
          />
        )
      }

      {
        showContents && (
          <aside class="rail">
            <nav class="toc" aria-label="Contents">
              <p class="toc-label">Contents</p>
              <ol>
                {sections.map((s) => (
                  <li>
                    <a href={`#${s.slug}`}>
                      <span class="toc-text">{s.text}</span>
                      <span class="toc-bar" aria-hidden="true">
                        <span class="toc-fill" />
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }

      <article class="prose">
        <Content />
      </article>
    </main>
  </div>
</BaseLayout>

<script>
  // Contents rail: each section's bar is sized by how long the section is on
  // the page, and fills as you read through it.
  const setup = () => {
    const prose = document.querySelector<HTMLElement>(".prose")
    const items = [...document.querySelectorAll<HTMLLIElement>(".toc li")]
    if (!prose || items.length === 0) return

    const heads = items.map((li) => {
      const hash = li.querySelector("a")!.hash.slice(1)
      return document.getElementById(decodeURIComponent(hash))
    })
    if (heads.some((h) => !h)) return

    let tops: number[] = []
    let lengths: number[] = []

    const measure = () => {
      tops = heads.map((h) => h!.getBoundingClientRect().top + window.scrollY)
      const end = prose.getBoundingClientRect().bottom + window.scrollY
      lengths = tops.map((top, i) => (tops[i + 1] ?? end) - top)
      const longest = Math.max(...lengths)
      items.forEach((li, i) =>
        li.style.setProperty("--length", String(lengths[i] / longest))
      )
      update()
    }

    const update = () => {
      // Read position sits a third of the way down the viewport
      const y = window.scrollY + window.innerHeight / 3
      let current = -1
      items.forEach((li, i) => {
        const progress = Math.min(1, Math.max(0, (y - tops[i]) / lengths[i]))
        li.style.setProperty("--progress", String(progress))
        if (y >= tops[i]) current = i
      })
      items.forEach((li, i) => {
        const link = li.querySelector("a")!
        if (i === current) link.setAttribute("aria-current", "location")
        else link.removeAttribute("aria-current")
      })
    }

    let frame = 0
    window.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame)
        frame = requestAnimationFrame(update)
      },
      { passive: true }
    )
    // Charts hydrate after load and change the page height, so re-measure
    new ResizeObserver(measure).observe(prose)
    measure()
  }

  setup()
</script>

<style>
  .layout {
    --column: 42rem;
    display: grid;
    grid-template-columns:
      minmax(1.5rem, 1fr)
      minmax(0, var(--column))
      minmax(1.5rem, 1fr);
    align-items: start;
  }

  .layout > * {
    grid-column: 2;
  }

  /* Header */

  .head {
    padding-top: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gray-300);
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  .back-link :global(svg) {
    width: 1em;
    height: 1em;
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--link-color);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }

  h1 {
    margin-top: 0.875rem;
    max-width: 20ch;
    color: var(--gray-0);
  }

  .dek {
    margin-top: 1.25rem;
    max-width: 36em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.1875rem 0.625rem;
    border: 1px solid var(--gray-700);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gray-200);
  }

  .cover {
    width: 100%;
    margin-top: 3rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--gray-800);
  }

  .prose {
    margin-top: 3.5rem;
  }

  /* Contents rail */

  .rail {
    display: none;
  }

  .toc {
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .toc-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gray-400);
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
    font-size: 0.875rem;
    line-height: 1.35;
    color: var(--gray-400);
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  .toc a:hover,
  .toc a:focus-visible,
  .toc a[aria-current] {
    color: var(--gray-0);
  }

  .toc-bar {
    display: block;
    width: calc(var(--length, 1) * 100%);
    height: 3px;
    border-radius: var(--radius-xs);
    background: var(--gray-800);
    overflow: hidden;
  }

  .toc-fill {
    display: block;
    height: 100%;
    background: var(--link-color);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc-fill {
      transition: transform 0.15s linear;
    }
  }

  @media (forced-colors: active) {
    .toc-bar {
      background: GrayText;
    }
    .toc-fill {
      background: Highlight;
    }
  }

  @media (min-width: 50em) {
    .head {
      padding-top: 3rem;
    }

    .meta {
      margin-top: 3rem;
    }
  }

  @media (min-width: 72rem) {
    .layout {
      column-gap: 3rem;
      grid-template-columns:
        minmax(12rem, 1fr)
        minmax(0, var(--column))
        minmax(12rem, 1fr);
    }

    /* Header and cover run past the text column on the right */
    .layout > .head,
    .layout > :global(.cover) {
      grid-column: 2 / 4;
      max-width: 60rem;
    }

    .layout > .rail {
      display: block;
      grid-column: 1;
      grid-row: 3;
      align-self: stretch;
      justify-self: end;
      width: min(100%, 15rem);
      margin-top: 3.5rem;
    }

    .layout > .prose {
      grid-row: 3;
    }
  }
</style>

<style is:global>
  /* Article body. Block rules target direct children so they don't leak into
     embedded components (charts, playgrounds). */

  .prose {
    font-family: var(--font-reading);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--gray-100);
    font-variant-numeric: oldstyle-nums;
  }

  .prose > * + * {
    margin-top: 1.25rem;
  }

  /* Heading sizes come from global.css */
  .prose > h2,
  .prose > h3,
  .prose > h4 {
    color: var(--gray-0);
    scroll-margin-top: 2rem;
  }

  .prose > h2 {
    margin-top: 3.5rem;
  }

  .prose > h3 {
    margin-top: 2.75rem;
  }

  .prose > h4 {
    margin-top: 2.25rem;
  }

  .prose > :is(h2, h3, h4) + * {
    margin-top: 0.875rem;
  }

  .prose > :first-child {
    margin-top: 0;
  }

  .prose strong {
    font-weight: 600;
    color: var(--gray-0);
  }

  .prose a {
    color: var(--link-color);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--theme-transition);
  }

  .prose a:hover,
  .prose a:focus-visible {
    text-decoration-color: currentColor;
  }

  /* Lists */

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }

  .prose li + li {
    margin-top: 0.5rem;
  }

  .prose li::marker {
    color: var(--gray-500);
  }

  .prose li > p {
    margin-top: 0.5rem;
  }

  /* A list of worked examples, each led by its formula */
  .prose > ul.cases {
    padding: 0;
    list-style: none;
  }

  .prose > ul.cases > li + li {
    margin-top: 2.5rem;
  }

  .prose > ul.cases > li > p:first-child {
    font-size: 1.375em;
    color: var(--gray-0);
  }

  /* Code */

  .prose :not(pre) > code {
    padding: 0.125em 0.3em;
    border-radius: var(--radius-xs);
    background: var(--gray-900);
    font-family: var(--font-mono);
    font-size: 0.84em;
    font-variant-numeric: normal;
    color: var(--gray-0);
    overflow-wrap: break-word;
  }

  /* Fenced code blocks are rendered by Expressive Code (astro.config.mjs) */
  .prose > .expressive-code {
    margin-block: 1.75rem;
  }

  /* Asides and quotes: set in the sans so they read as notes beside the text */

  .prose blockquote {
    padding: 0.125rem 0 0.125rem 1.125rem;
    border-left: 2px solid var(--link-color);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--gray-300);
  }

  .prose blockquote > * + * {
    margin-top: 0.75rem;
  }

  .prose blockquote strong {
    color: var(--gray-100);
  }

  /* Media */

  .prose img {
    display: block;
    margin-inline: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--gray-800);
  }

  .prose .katex {
    font-size: 1.05em;
  }

  .prose .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25rem;
  }

  .prose > hr {
    height: 1px;
    margin-block: 3rem;
    border: 0;
    background: var(--gray-800);
  }

  /* Tables */

  .prose > table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .prose > table th {
    padding: 0 1rem 0.5rem 0;
    border-bottom: 1px solid var(--gray-700);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gray-400);
  }

  .prose > table td {
    padding: 0.625rem 1rem 0.625rem 0;
    border-bottom: 1px solid var(--gray-800);
    vertical-align: top;
  }

  @media (max-width: 40em) {
    .prose > table {
      display: block;
      overflow-x: auto;
    }
  }

  @media (min-width: 50em) {
    .prose {
      font-size: 1.1563rem;
    }
  }
</style>
