---
import BaseLayout from "../layouts/BaseLayout.astro"
import Icon from "../components/Icon.astro"
import PostPreview from "../components/PostPreview.astro"
import { Image } from "astro:assets"
import { getCollection } from "astro:content"

import portrait from "../assets/portrait.jpg"
import { site } from "../data/site"
import { PAST_EXPERIENCES, yearsOfExperience } from "../data/resume"
import { FLIGHTS, getVisitedCountries } from "../data/travel"
import { MERGED_PRS, POSTHOG_REPO, WORK, prUrl } from "../data/work"

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2)

const current = PAST_EXPERIENCES[0]
const countries = getVisitedCountries().size


const FACTS = [
  { label: "Countries", value: `${countries}` },
  { label: "Flights logged", value: `${FLIGHTS.length}` },
  { label: "Years shipping", value: `${yearsOfExperience()}+` },
  { label: "Cat", value: "1" },
]
---

<BaseLayout>
  <div class="stack gap-20 mb-4">
    <main class="wrapper home">
      <header class="hero">
        <div class="hero-intro">
          <p class="eyebrow">Product engineer · {site.location}</p>
          <h1 class="hero-title">Hi, I'm Rafa. I build data products at PostHog.</h1>
          <p class="text-dek">
            {yearsOfExperience()}+ years shipping full-stack software, from seed-stage startups to a scale-up.
            I started Revenue Analytics on my own, shipped Core Web Vitals for Web Analytics, and now lead
            the Growth team. When I'm not at the keyboard I'm usually at an airport.
          </p>
          <div class="hero-actions">
            <a class="action action-primary" href="/resume/">Read my resume <Icon icon="arrow-right" size="1em" /></a>
            <a class="action" href="/blog/">Read the blog</a>
          </div>
        </div>

        <Image
          alt="Rafa Audibert smiling with a blue beanie and a black jacket in front of the Big Ben in London, UK"
          src={portrait}
          widths={[480, 800, 1200]}
          sizes="(min-width: 50em) 40vw, 100vw"
          loading="eager"
          tabindex="0"
          role="button"
          title="Click 5 times for a surprise"
          aria-label="Click 5 times for a surprise"
        />
      </header>

      <section class="labelled-section" aria-labelledby="work">
        <div class="section-label">
          <h2 class="section-title" id="work">Work</h2>
          <a
            class="section-more"
            href={`${POSTHOG_REPO}/pulls?q=is%3Apr+is%3Amerged+author%3Arafaeelaudibert`}
            target="_blank"
            rel="noopener noreferrer"
          >
            All {MERGED_PRS.count} PRs <Icon icon="arrow-square-out" size="0.9em" />
            <span class="sr-only">(opens in new tab)</span>
          </a>
        </div>
        <div class="stack gap-4 work">
          <p class="text-reading work-intro">
            Everything below is in the open on <a href={POSTHOG_REPO}>posthog/posthog</a>: {MERGED_PRS.count} merged
            pull requests between {MERGED_PRS.since} and {MERGED_PRS.asOf}, grouped by what they built. Newest first.
          </p>
          <ol class="work-list">
            {
              WORK.map((item) => (
                <li class="work-item">
                  <span class="work-period text-meta">{item.period}</span>
                  <div class="work-body">
                    <h3 class="work-title">{item.title}</h3>
                    <p class="work-text text-reading">{item.summary}</p>
                    <ul class="pr-list">
                      {item.prs.map((pr) => (
                        <li>
                          <a class="pr" href={prUrl(pr.number)} target="_blank" rel="noopener noreferrer">
                            <span class="pr-number">#{pr.number}</span> {pr.label}
                            <span class="sr-only">(opens in new tab)</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="labelled-section" aria-labelledby="writing">
        <div class="section-label">
          <h2 class="section-title" id="writing">Writing</h2>
          <a class="section-more" href="/blog/">All posts <Icon icon="arrow-right" size="0.9em" /></a>
        </div>
        <div class="stack gap-4 writing">
          <p class="text-reading writing-intro">
            Long-form, infrequent, and usually with data attached: sorting algorithms and hash tables from
            university, what applying to remote jobs actually looks like in numbers, and what happened when I
            let Claude move this site off AWS.
          </p>
          <ul class="posts">
            {
              posts.map((post) => (
                <li>
                  <PostPreview post={post} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="labelled-section" aria-labelledby="beyond">
        <h2 class="section-title" id="beyond">Beyond work</h2>
        <div class="beyond">
          <div class="beyond-text text-reading">
            <p>
              Computer Science at UFRGS, <i>summa cum laude</i>, with an exchange year at TU Kaiserslautern in
              Germany and two trips to the Brazilian ICPC finals along the way. Married to Lili since April
              2026. Our cat is called Aura.
            </p>
            <p>
              Travel is the other constant: <a href="/travel/">{countries} countries and territories</a> so
              far, most of them shared with Lili. The <a href="/changelog/">changelog</a> keeps the running
              record, from offsites in Barbados and Tulum to watching a total solar eclipse from a boat off
              Mallorca.
            </p>
          </div>
          <ul class="facts">
            {
              FACTS.map((fact) => (
                <li class="fact">
                  <span class="fact-value">{fact.value}</span>
                  <span class="eyebrow">{fact.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>
  </div>

</BaseLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Hero: intro beside the portrait, like the split headers elsewhere */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1rem;
  }

  .hero-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-title {
    color: var(--gray-0);
    max-width: 18ch;
  }

  .hero-intro .text-dek {
    max-width: 44em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.625rem 1rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-sm);
    background-color: var(--gray-999);
    color: var(--gray-100);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--theme-transition),
      border-color var(--theme-transition),
      color var(--theme-transition);
  }

  .action:hover,
  .action:focus-visible {
    border-color: var(--accent-regular);
    color: var(--gray-0);
  }

  .action-primary {
    border-color: var(--accent-regular);
    background-color: var(--accent-regular);
    color: var(--accent-text-over);
  }

  .action-primary:hover,
  .action-primary:focus-visible {
    background-color: var(--accent-dark);
    border-color: var(--accent-dark);
    color: var(--accent-text-over);
  }

  .hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    user-select: none;
  }

  /* Work: a timeline of what the PRs added up to */
  .work-intro {
    max-width: 60ch;
    color: var(--gray-300);
  }

  .work-intro a {
    color: var(--link-color);
  }

  .work-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 0;
    list-style: none;
  }

  .work-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .work-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .work-title {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--gray-0);
  }

  .work-text {
    max-width: 66ch;
    color: var(--gray-300);
    line-height: 1.6;
  }

  .pr-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .pr {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-sm);
    background-color: var(--gray-999_40);
    font-size: 0.8125rem;
    color: var(--gray-100);
    text-decoration: none;
    transition:
      border-color var(--theme-transition),
      color var(--theme-transition);
  }

  .pr:hover,
  .pr:focus-visible {
    border-color: var(--accent-regular);
    color: var(--gray-0);
  }

  .pr-number {
    font-family: var(--font-mono);
    color: var(--gray-400);
  }

  .section-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gray-100);
    text-decoration: underline transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--theme-transition),
      text-decoration-color var(--theme-transition);
  }

  .section-more:hover,
  .section-more:focus-visible {
    color: var(--gray-0);
    text-decoration-color: currentColor;
  }

  /* Writing */
  .section-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .section-more {
    margin-top: 0;
  }

  .writing-intro {
    max-width: 60ch;
    color: var(--gray-300);
  }

  .posts {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  /* Beyond work */
  .beyond {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .beyond-text {
    max-width: 60ch;
    color: var(--gray-200);
  }

  .beyond-text p + p {
    margin-top: 1rem;
  }

  .beyond-text a {
    color: var(--link-color);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .beyond-text a:hover,
  .beyond-text a:focus-visible {
    text-decoration-color: currentColor;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .fact-value {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--accent-regular);
  }

  @media (min-width: 50em) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
      gap: 3rem;
      padding-top: 2rem;
    }

    .hero img {
      aspect-ratio: 4 / 5;
    }

    .section-label {
      flex-direction: column;
      align-items: flex-start;
      align-self: start;
      position: sticky;
      top: 1.5rem;
    }

    .work-item {
      display: grid;
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1.5rem;
    }

    .work-period {
      padding-top: 0.3em;
    }

    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .beyond {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 3rem;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action,
    .pr,
    .section-more,
    .beyond-text a {
      transition: none;
    }
  }
</style>
