---
import BaseLayout from "../layouts/BaseLayout.astro"
import Icon from "../components/Icon.astro"
import PostPreview from "../components/PostPreview.astro"
import { Image } from "astro:assets"
import { getCollection } from "astro:content"

import portrait from "../assets/portrait.jpg"
import { site } from "../data/site"
import { PAST_EXPERIENCES, yearsOfExperience } from "../data/resume"
import { FLIGHTS, getVisitedCountries } from "../data/travel"
import Link from "../components/Link.astro"
import PullRequest from "../components/PullRequest.astro"
import { MERGED_PRS, POSTHOG_REPO, PRS } from "../data/work"

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2)

const current = PAST_EXPERIENCES[0]
const countries = getVisitedCountries().size

const FACTS = [
  { label: "Countries", value: `${countries}` },
  { label: "Flights logged", value: `${FLIGHTS.length}` },
  { label: "Years shipping", value: `${yearsOfExperience()}+` },
  { label: "Cat", value: "1" },
]
---

<BaseLayout>
  <div class="stack gap-20 mb-4">
    <main class="wrapper home">
      <header class="hero">
        <div class="hero-intro">
          <p class="eyebrow">Product engineer · {site.location}</p>
          <h1 class="hero-title">Hi, I'm Rafa. I build products at PostHog.</h1>
          <p class="text-dek">
            {yearsOfExperience()}+ years shipping full-stack software, from
            seed-stage startups to a scale-up. I started Revenue Analytics on my
            own, shipped Core Web Vitals for Web Analytics, and now lead the
            Growth team. When I'm not at the keyboard I'm usually at an airport.
          </p>
          <div class="hero-actions">
            <Link
              class="action action-primary"
              href="/resume/"
              external={false}
            >
              Read my resume <Icon icon="arrow-right" size="1em" />
            </Link>
            <Link class="action" href="/blog/" external={false}
              >Read the blog</Link
            >
          </div>
        </div>

        <Image
          alt="Rafa Audibert smiling with a blue beanie and a black jacket in front of the Big Ben in London, UK"
          src={portrait}
          widths={[480, 800, 1200]}
          sizes="(min-width: 50em) 40vw, 100vw"
          loading="eager"
          tabindex="0"
          role="button"
          title="Click 5 times for a surprise"
          aria-label="Click 5 times for a surprise"
        />
      </header>

      <section class="labelled-section" aria-labelledby="work">
        <h2 class="section-title" id="work">Work</h2>
        <ul class="work-grid">
          <li class="work-card">
            <p class="eyebrow">Now</p>
            <h3 class="work-title">Leading Growth at PostHog</h3>
            <p class="work-text text-reading">
              Onboarding, activation and the paths that turn a signup into a
              paying customer. Also responsible for trying to figure out how do
              we grow in an agentic world.
            </p>
            <p class="work-text text-reading">
              Before that I started Revenue Analytics on my own and shipped Core
              Web Vitals for Web Analytics.
            </p>
            <Link class="work-link" href={current.href} utm="growth-card">
              PostHog <Icon icon="arrow-square-out" size="0.9em" />
            </Link>
          </li>

          <li class="work-card">
            <p class="eyebrow">In the open</p>
            <h3 class="work-title">
              Two years of pull requests to posthog/posthog
            </h3>
            <p class="work-text text-reading">
              All public. I built the Core Web Vitals view <PullRequest
                number={PRS.webVitals}
              /> in my first months. Also a toolbar that loads in a kilobyte{" "}
              <PullRequest number={PRS.toolbar} />.
            </p>
            <p class="work-text text-reading">
              On Growth I shipped organisation-level product push campaigns{" "}
              <PullRequest number={PRS.campaigns} /> and the empty state screens for
              every product{" "}
              <PullRequest number={PRS.emptyStates} />.
            </p>
            <p class="work-text text-reading">
              Lately it has been authentication: PostHog as an OpenID Connect
              provider <PullRequest number={PRS.oidc} />, and partners
              authenticating as OAuth clients{" "}
              <PullRequest number={PRS.partners} />.
            </p>
            <Link
              class="work-link"
              href={`${POSTHOG_REPO}/pulls?q=is%3Apr+is%3Amerged+author%3Arafaeelaudibert`}
              utm="all-prs"
            >
              All of them, since {MERGED_PRS.since}
              <Icon icon="arrow-square-out" size="0.9em" />
            </Link>
          </li>

          <li class="work-card">
            <p class="eyebrow">MCP</p>
            <h3 class="work-title">
              Model Context Protocol, at work and at home
            </h3>
            <p class="work-text text-reading">
              At PostHog I helped architect our first MCP, built apps that
              render inside MCP clients <PullRequest number={PRS.mcpApps} />,
              and added Client ID Metadata Documents so clients such as Claude
              Code connect with a URL instead of registering first{" "}
              <PullRequest number={PRS.cimd} />. Here, this site runs its own
              MCP server, so you can point Claude or Cursor at it and ask about
              me.
            </p>
            <Link class="work-link" href="/mcp/" external={false}>
              This site's MCP server <Icon icon="arrow-right" size="0.9em" />
            </Link>
          </li>

          <li class="work-card">
            <p class="eyebrow">Side business</p>
            <h3 class="work-title">Trio Assinaturas</h3>
            <p class="work-text text-reading">
              A platform for subscription box clubs in Brazil: plans,
              subscribers, recurring card and PIX billing with retries,
              shipping, a sales page and checkout, and a member area where
              subscribers help themselves.
            </p>
            <Link
              class="work-link"
              href="https://trioassinaturas.com.br"
              utm="trio-card"
            >
              trioassinaturas.com.br <Icon
                icon="arrow-square-out"
                size="0.9em"
              />
            </Link>
          </li>
        </ul>
      </section>

      <section class="labelled-section" aria-labelledby="writing">
        <div class="section-label">
          <h2 class="section-title" id="writing">Writing</h2>
          <Link class="section-more" href="/blog/" external={false}>
            All posts <Icon icon="arrow-right" size="0.9em" />
          </Link>
        </div>
        <div class="stack gap-4 writing">
          <p class="text-reading writing-intro">
            Long-form, infrequent, and usually with data attached: sorting
            algorithms and hash tables from university, what applying to remote
            jobs actually looks like in numbers, and what happen when I let
            Claude move this site off AWS.
          </p>
          <ul class="posts">
            {
              posts.map((post) => (
                <li>
                  <PostPreview post={post} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="labelled-section" aria-labelledby="beyond">
        <h2 class="section-title" id="beyond">Beyond work</h2>
        <div class="beyond">
          <div class="beyond-text text-reading">
            <p>
              Computer Science at UFRGS, <i>summa cum laude</i>, with an
              exchange year at TU Kaiserslautern in Germany and two trips to the
              Brazilian ICPC finals along the way. Married to Lili since April
              2026. Our cat is called Aura.
            </p>
            <p>
              Travel is the other constant: <Link
                href="/travel/"
                external={false}>{countries} countries and territories</Link
              > so far, most of them shared with Lili. The <Link
                href="/changelog/"
                external={false}>changelog</Link
              > keeps the running record, from offsites in Barbados and Tulum to watching
              a total solar eclipse from a boat off Mallorca.
            </p>
          </div>
          <ul class="facts">
            {
              FACTS.map((fact) => (
                <li class="fact">
                  <span class="fact-value">{fact.value}</span>
                  <span class="eyebrow">{fact.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Hero: intro beside the portrait, like the split headers elsewhere */
  .hero {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-title {
    color: var(--gray-0);
    max-width: 18ch;
  }

  .hero-intro .text-dek {
    max-width: 44em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.625rem 1rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-sm);
    background-color: var(--gray-999);
    color: var(--gray-100);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color var(--theme-transition),
      border-color var(--theme-transition),
      color var(--theme-transition);
  }

  .action:hover,
  .action:focus-visible {
    border-color: var(--accent-regular);
    color: var(--gray-0);
  }

  .action-primary {
    border-color: var(--accent-regular);
    background-color: var(--accent-regular);
    color: var(--accent-text-over);
  }

  .action-primary:hover,
  .action-primary:focus-visible {
    background-color: var(--accent-dark);
    border-color: var(--accent-dark);
    color: var(--accent-text-over);
  }

  /* On phones the portrait is a short landscape crop centred on the face;
     the desktop column shows it upright and top-anchored */
  .hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    user-select: none;
  }

  /* Work */
  .work-grid {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--gray-800);
    border-radius: var(--radius-md);
    background-color: var(--gray-999_40);
  }

  .work-title {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--gray-0);
  }

  .work-text {
    color: var(--gray-300);
    line-height: 1.6;
  }

  .work-card > :last-child {
    margin-top: auto;
  }

  .work-link,
  .section-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--gray-100);
    text-decoration: underline transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--theme-transition),
      text-decoration-color var(--theme-transition);
  }

  .work-link:hover,
  .work-link:focus-visible,
  .section-more:hover,
  .section-more:focus-visible {
    color: var(--gray-0);
    text-decoration-color: currentColor;
  }

  /* Writing */
  .section-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .section-more {
    margin-top: 0;
  }

  .writing-intro {
    max-width: 60ch;
    color: var(--gray-300);
  }

  .posts {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  /* Beyond work */
  .beyond {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .beyond-text {
    max-width: 60ch;
    color: var(--gray-200);
  }

  .beyond-text p + p {
    margin-top: 1rem;
  }

  .beyond-text a {
    color: var(--link-color);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  .beyond-text a:hover,
  .beyond-text a:focus-visible {
    text-decoration-color: currentColor;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .fact-value {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--accent-regular);
  }

  @media (min-width: 50em) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      align-items: center;
      gap: 3rem;
      padding-top: 2rem;
    }

    .hero img {
      aspect-ratio: 4 / 5;
      object-position: top;
    }

    .section-label {
      flex-direction: column;
      align-items: flex-start;
      align-self: start;
      position: sticky;
      top: 1.5rem;
    }

    .work-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .beyond {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 3rem;
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action,
    .work-link,
    .section-more,
    .beyond-text a {
      transition: none;
    }
  }
</style>
